# ==============================================================================
# MediCore Pharmacy ERP - Environment Configuration Example
# Copy this file to .env and adjust variables for your target environment.
# ==============================================================================

# Application Environment & Debugging
APP_NAME="MediCore ERP"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://pharmacy.yourdomain.com
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=en

# Database Configuration (MySQL / MariaDB)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=medicore
DB_USERNAME=medicore_user
DB_PASSWORD=your_strong_database_password_here

# Security & JSON Web Token (JWT)
# Generate with: php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=generate_your_secure_256_bit_random_secret_here
JWT_ALGORITHM=HS256
JWT_EXPIRY=3600
JWT_REFRESH_EXPIRY=604800

# Session & Cookie Security
SESSION_LIFETIME=7200
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=true

# SMTP Mail Server Configuration
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_smtp_username@domain.com
MAIL_PASSWORD=your_smtp_app_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@yourdomain.com
MAIL_FROM_NAME="MediCore Pharmacy ERP"
MAIL_REPLY_TO=support@yourdomain.com
MAIL_DEBUG=false

# Logging & Storage
LOG_CHANNEL=daily
LOG_LEVEL=info